# Copie este arquivo para ".env" e preencha os valores.

# URL do seu projeto Supabase: https://app.supabase.com > Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Service role key do Supabase (Settings > API > service_role).
# ATENCAO: use a service_role, NAO a anon/publishable.
SUPABASE_SERVICE_KEY=SUA_SERVICE_ROLE_KEY_AQUI

# Senha de acesso ao dashboard (fica no servidor, nunca no site)
DASHBOARD_PASSWORD=troque-esta-senha

# Texto aleatorio usado para assinar o cookie de sessao
SESSION_SECRET=troque-este-segredo-por-algo-longo-e-aleatorio

# Porta usada pelo servidor. Na Hostinger Node, deixe vazio (usa a da plataforma).
PORT=